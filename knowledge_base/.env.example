# Скопируйте в knowledge_base/.env и заполните значениями
# НЕ коммитить .env файл!

# Telegram API (https://my.telegram.org)
TELEGRAM_API_ID=30159716
TELEGRAM_API_HASH=your_hash_here

# SOCKS5 (оставьте пустым вне корпоративной сети)
SOCKS5_HOST=tp.sds.kari.local
SOCKS5_PORT=18001
SOCKS5_USER=tg
SOCKS5_PASS=your_pass_here

# Yandex Cloud (https://console.yandex.cloud)
YANDEX_API_KEY=your_key_here
YANDEX_FOLDER_ID=your_folder_id

# SSL (true = пропустить проверку, нужно при корпоративном DPI)
SKIP_SSL_VERIFY=true
